source":"mapbox.js","original":{"line":47,"column":2}}],"sources":{"mapbox.js":"/* global document, mapboxgl */\n\nexport const displayMap = (locations) => {\n  const mapElement = document.getElementById(\"map\");\n  if (!mapElement) return;\n\n  const accessToken = mapElement.dataset.mapboxToken;\n  if (!accessToken) {\n    throw new Error(\"MAPBOX_ACCESS_TOKEN is missing or invalid.\");\n  }\n\n  mapboxgl.accessToken = accessToken;\n\n  const map = new mapboxgl.Map({\n    container: \"map\",\n    style: \"mapbox://styles/mapbox/streets-v12\",\n    scrollZoom: false,\n  });\n\n  map.addControl(new mapboxgl.NavigationControl(), \"top-right\");\n\n  locations.forEach((location) => {\n    const marker = document.createElement(\"div\");\n    marker.className = \"marker\";\n\n    const mapMarker = new mapboxgl.Marker({\n      element: marker,\n      anchor: \"bottom\",\n    })\n      .setLngLat(location.coordinates)\n      .setPopup(\n        new mapboxgl.Popup({ offset: 30 }).setHTML(\n          `<p class=\"mapbox-popup\">Day ${location.day}: ${location.description}</p>`,\n        ),\n      );\n\n    mapMarker.addTo(map);\n    mapMarker.togglePopup();\n  });\n\n  const bounds = new mapboxgl.LngLatBounds();\n  locations.forEach((location) => bounds.extend(location.coordinates));\n  map.fitBounds(bounds, {\n    padding: { top: 100, bottom: 100, left: 100, right: 100 },\n    maxZoom: 12,\n  });\n};\n"},"lineCount":null}},"error":null,"hash":"61b02c80ed6a19442a94b481c7274ac9","cacheData":{"env":{}}}