extends base

mixin nav-item(icon, label, link='#', active=false)
  li(class=active ? 'side-nav--active' : '')
    a(href=link)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{label}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +nav-item('settings', 'Settings', '/me', true)
          +nav-item('briefcase', 'My bookings', '/my-tours')
          +nav-item('star', 'My reviews', '/my-reviews')
          +nav-item('credit-card', 'Billing')

        if user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +nav-item('map', 'Manage tours', '/manage-tours')
              +nav-item('users', 'Manage users', '/manage-users')
              +nav-item('star', 'Manage reviews', '/manage-reviews')
              +nav-item('briefcase', 'Manage bookings', '/manage-bookings')

      .user-view__content
        .user-view__form-container
          h2.heading-secondary.ma-bt-md Your account settings
          //without API
          //- form.form.form-user-data(
          //-   action='/update-user-data',
          //-   method='POST'
          //- )
          //with 
          form.form.form-user-data
            .form__group
              label.form__label(for='name') Name
              input#name.form__input(
                type='text',
                name='name',
                value=user.name,
                required
              )

            .form__group.ma-bt-md
              label.form__label(for='email') Email address
              input#email.form__input(
                type='email',
                name='email',
                value=user.email,
                required
              )

            .form__group.form__photo-upload
              img.form__user-photo(
                src=`/img/users/${user.photo}`,
                alt=`Photo of ${user.name}`
              )
              input#photo.form__upload(
                type='file',
                accept='image/*',
                name='photo'
              )
              label.btn-text(for='photo') Choose new photo

            .form__group.right
              button.btn.btn--small.btn--green(type='submit') Save settings

        .line &nbsp;

        .user-view__form-container
          h2.heading-secondary.ma-bt-md Password change
          form.form.form-user-settings(
            action='/update-password',
            method='POST'
          )
            .form__group
              label.form__label(for='password-current') Current password
              input#password-current.form__input(
                type='password',
                name='passwordCurrent',
                placeholder='••••••••',
                required,
                minlength='8'
              )

            .form__group
              label.form__label(for='password-new') New password
              input#password-new.form__input(
                type='password',
                name='password',
                placeholder='••••••••',
                required,
                minlength='8'
              )

            .form__group.ma-bt-lg
              label.form__label(for='password-confirm') Confirm password
              input#password-confirm.form__input(
                type='password',
                name='passwordConfirm',
                placeholder='••••••••',
                required,
                minlength='8'
              )

            .form__group.right
              button.btn.btn--small.btn--green.btn--save-password(type='submit') Save password